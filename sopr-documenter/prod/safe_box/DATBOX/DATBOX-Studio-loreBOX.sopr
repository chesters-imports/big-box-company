  "parts": {
    "SPR-0001": {
      "part_code": "SPR-0001",
      "leaf": "loreBOX is a simple datmat container tool for containing fragments of lore related to anything you wish to store!",
      "section_id": "sec-0002",
      "created_at": 1785061297.4711711,
      "as_pre": false
    },
    "SPR-0003": {
      "part_code": "SPR-0003",
      "leaf": "Just name the container whatever you are most likely to remember later.",
      "section_id": "sec-0002",
      "created_at": 1785061347.970399,
      "as_pre": false
    },
    "SPR-0004": {
      "part_code": "SPR-0004",
      "leaf": "Don't worry, you can rename it later!",
      "section_id": "sec-0002",
      "created_at": 1785061361.6089437,
      "as_pre": false
    },
    "SPR-0005": {
      "part_code": "SPR-0005",
      "leaf": "You will also choose a storage box name. If you can't think of one, don't worry. One is already filled in for you.",
      "section_id": "sec-0002",
      "created_at": 1785061488.3548946,
      "as_pre": false
    },
    "SPR-0006": {
      "part_code": "SPR-0006",
      "leaf": "Don't like the storage file name? Don't worry! You can make your own, and rename it any time! No mistakes here!",
      "section_id": "sec-0002",
      "created_at": 1785061506.7820847,
      "as_pre": false
    }
  },
